[Unit]
Description=Link Intelligence Platform — Web Server
After=network.target redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/link-intelligence
EnvironmentFile=/home/ubuntu/link-intelligence/.env
ExecStart=/home/ubuntu/link-intelligence/venv/bin/python scripts/run_web.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/link-intelligence/logs/web.log
StandardError=append:/home/ubuntu/link-intelligence/logs/web.err

[Install]
WantedBy=multi-user.target
