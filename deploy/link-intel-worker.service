[Unit]
Description=Link Intelligence Platform — Background Workers (collect + classify + vitality)
After=network.target redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/link-intelligence
EnvironmentFile=/home/ubuntu/link-intelligence/.env
ExecStart=/home/ubuntu/link-intelligence/venv/bin/python scripts/run_worker.py all
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/link-intelligence/logs/worker.log
StandardError=append:/home/ubuntu/link-intelligence/logs/worker.err

[Install]
WantedBy=multi-user.target
