# ============================================================
# Link Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- Database (SQLite — no Docker) ---
DATABASE_URL=sqlite:///./data/link_intel.db
# Path where SQLite file lives (created on first run)
SQLITE_PATH=./data/link_intel.db

# --- Redis (for queues & cache; install separately, NOT via Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram (Userbot - Telethon) ---
# Get from https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Phone number with country code, e.g. +1234567890
TG_PHONE=
# Session name (will create <name>.session file)
TG_SESSION_NAME=userbot_main
# Comma-separated list of channels/usernames to monitor
TG_MONITOR_CHANNELS=
# Set to "true" to use Mock Collector (no real Telegram connection)
TG_MOCK_MODE=true

# --- Telegram Bot (BotFather) ---
# Create via @BotFather, used for /search /stats /popular commands
TG_BOT_TOKEN=

# --- LLM Providers (fill what you have; orchestrator will skip empty ones) ---
# OpenRouter: https://openrouter.ai/keys (free tier available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# HuggingFace: https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Z.AI SDK (uses ZAI_API_KEY env if available; otherwise HTTP fallback)
ZAI_API_KEY=
ZAI_MODEL=glm-4-flash

# --- v5.0 Additional LLM providers (fill what you have) ---
# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Together AI: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-8b-chat-hf
# Anyscale: https://console.anyscale.com/v2/api-keys
ANYSCALE_API_KEY=
ANYSCALE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Cloudflare Workers AI: https://dash.cloudflare.com → API Tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Stripe billing (v5.0 SaaS) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Multi-tenant SaaS mode ---
# Set to true to require X-API-Key header on every API request
SAAS_MODE=false

# --- Classification thresholds ---
# Similarity threshold for semantic memory reuse (0-1)
SEMANTIC_REUSE_THRESHOLD=0.92
# Max links to verify per minute (vitality checker rate limit)
VITALITY_RATE_PER_MIN=6

# --- Collector human behavior ---
COLLECT_MIN_DELAY_SEC=8
COLLECT_MAX_DELAY_SEC=25
COLLECT_ACTIVE_HOURS_START=8
COLLECT_ACTIVE_HOURS_END=23

# --- Encryption ---
# 32-byte (256-bit) key as hex string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AES_ENCRYPTION_KEY=
# Separate HMAC key (32 bytes hex)
HMAC_KEY=

# --- Web panel auth (basic, single-user for MVP) ---
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-me

# --- Oracle Cloud Deployment (CI/CD) ---
# Used by .github/workflows/deploy.yml
ORACLE_HOST=
ORACLE_USER=ubuntu
ORACLE_SSH_KEY=
ORACLE_DEPLOY_PATH=/home/ubuntu/link-intelligence
