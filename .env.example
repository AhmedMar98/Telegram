# Copy to .env for local development. Never commit the filled-in file.
# On Render these are set in the dashboard; on GitHub Actions, as secrets.

# --- Core (required) ---
DATABASE_URL=sqlite:///./local.db
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development

# --- Registration gate (optional but recommended) ---
# When set, creating an account requires this code. Leave empty to allow
# anyone who can reach the public URL to self-register.
INVITE_CODE=

# --- Telegram bot (optional; webhook mode) ---
# BOT_TOKEN comes from @BotFather. PUBLIC_BASE_URL is the https URL Render
# assigns the service; the webhook is registered automatically at startup.
BOT_TOKEN=
BOT_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# --- Optional free LLM classification tier ---
# Without this the rules-based classifier still handles every link at zero
# cost; setting it only adds accuracy on low-confidence results.
GROQ_API_KEY=

# --- Collector (GitHub Actions secrets, not needed by the web service) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
COLLECTOR_WORKSPACE_ID=
COLLECTOR_MESSAGE_LIMIT=200
# The collector registers the account's own dialogs instead of collecting
# only what was typed into the dashboard. Set to false to go back to
# hand-added channels only.
COLLECTOR_AUTO_DISCOVER=true
# Which dialog kinds discovery may register: all, or any comma-separated
# subset of channel, group, private.
# "private" means personal one-to-one conversations, and a stored link
# carries up to 2000 characters of the message around it — including what
# the other person wrote. Narrow this if that is not what you want.
COLLECTOR_SCOPE=all
# Dialogs one discovery pass may register per account. The rest follow on
# later runs; discovery never re-registers what it already knows.
COLLECTOR_MAX_DIALOGS=200

# --- proactive pacing (anti-ban) --------------------------------------------
# A randomised pause between dialogs, so the request pattern does not look
# mechanical. Randomised rather than fixed: a constant gap is itself a
# signature, and what is being avoided is looking like a program.
COLLECTOR_PACE_MIN_SECONDS=1.5
COLLECTOR_PACE_MAX_SECONDS=4.0
# The pacing BUDGET for a whole run, and the reason pacing is not simply a
# sleep per dialog: 4s x 20 dialogs x 10 accounts is 800 seconds added to an
# hourly job on runners that are already late under load — the shield would
# cause the outage it exists to prevent. Pauses are spent from this budget;
# when it runs out the collector stops pausing and finishes its work.
# Set to 0 to turn pacing off entirely.
COLLECTOR_PACE_BUDGET_SECONDS=240

# --- public sources (no account, no ban risk) -------------------------------
# How many `source = public` channels one scrape run reads. These are read
# from Telegram's anonymous web preview, so there is no account to
# rate-limit — the cap bounds the job's runtime, not an account's risk.
SCRAPER_MAX_SOURCES=50

# Which Telegram chats may talk to the bot at all, comma separated.
# EMPTY MEANS EVERYONE, which is what it has always done — so an upgrade
# cannot lock out a linked chat. Set it to make the bot private in the
# strong sense: an unlisted chat gets no reply, not even the help text.
BOT_ALLOWED_CHAT_IDS=

# Whether the bot may onboard a collection account (phone + one-time code).
# OFF by default. What travels through the chat is NOT api_hash and NOT the
# session string — those never leave the server — but the one-time code
# does, and the two-factor password does if the account has one. The flow
# refuses to run outside a one-to-one chat and deletes each sensitive
# message as it reads it, but enable it deliberately.
BOT_ACCOUNT_ONBOARDING=false

# --- lead detection: the second product -------------------------------------
# OFF by default, and not as a convenience. Everything stored until now was a
# link; with this on the system also stores identifiable third parties who
# never opted in — their Telegram id, handle, display name, and the text of
# what they asked for.
LEADS_ENABLED=false
# How long a matched message is kept, in days. 0 disables the purge. The
# beneficiary row and its counter survive it, so "has asked four times"
# outlives the texts themselves.
LEADS_RETENTION_DAYS=90
# Encrypts the collected session string before it is stored in the
# database (app/crypto.py). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The default below is published in this repo — fine for local dev,
# but a real deployment must set its own or the encryption is decorative.
FIELD_ENCRYPTION_KEY=S7uvgQ59s2Xo-V2u3yZdnqZLxhnienyS6rirAOJ_pnA=
# Only set while running scripts/rotate_encryption_key.py: the key the
# rows are encrypted with *today*, so they can be re-encrypted under the
# new FIELD_ENCRYPTION_KEY above. Unset it again once rotation is done.
FIELD_ENCRYPTION_KEY_OLD=

# --- Vitality checker (GitHub Actions secrets; only needs DATABASE_URL) ---
VITALITY_CHECK_BATCH_LIMIT=300
VITALITY_CHECK_CONCURRENCY=15
VITALITY_CHECK_TIMEOUT_SECONDS=10

# --- Status board reporting (GitHub Actions secrets) ---
# The credential inversion from phase 10: scheduled runs report their own
# outcome *to* the service instead of the service reading GitHub's API, so
# no repository token is ever stored in the database.
#
# APP_API_KEY is a personal API key created from the dashboard
# ("مفاتيح API"). It can write to /status/workflow-runs and nothing else —
# it cannot even read the board back.
#
# Leaving these unset is not an error and breaks nothing, but the status
# board then stays empty forever, which reads exactly like "every workflow
# stopped". smoke.yml needs APP_BASE_URL for the same reason.
APP_BASE_URL=
APP_API_KEY=

# --- Backups (.github/workflows/backup.yml) ---
#
# The daily dump is encrypted with AES-256 before it is uploaded, because
# the artifact contains every collected link plus the telegram_accounts
# rows. Without this secret the workflow FAILS rather than uploading a
# plaintext dump: a backup that quietly stops protecting anything while
# still reporting success is worse than no backup at all.
#
# Store this somewhere that is NOT this repository and NOT the same place
# as the database credentials. Losing it makes every existing backup
# permanently unreadable — that is the deliberate trade.
#
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_PASSPHRASE=

# --- Logging ---
LOG_LEVEL=INFO
